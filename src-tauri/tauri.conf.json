{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CZTool",
  "version": "30.0.0",
  "identifier": "com.cztool.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CZTool",
        "width": 1400,
        "height": 800,
        "minWidth": 1400,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEOTA2Q0ZGQUY1REYzMzMKUldRejgxMnYvMnlRelhlNVk1cFhHQVlpWnFWWm4xWGVSdHFIV3drNEpFTWN6K205Y3o3R3FEUVIK",
      "endpoints": [
        "https://github.com/vvitem/cztool/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
