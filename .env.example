# CZTool 环境变量示例（复制为 .env 后按需填写）

# 解锁 API（对接 EdgeKey 的 Cloudflare Worker）
# 本地: http://127.0.0.1:8787
# 生产: https://cztu.oihome.dpdns.org/
VITE_UNLOCK_API_URL=https://cztu.oihome.dpdns.org/

# EdgeKey 发卡商城
VITE_EDGEKEY_SHOP_URL=https://czt.oihome.dpdns.org/

# 开发时跳过解锁门闸（仅 npm run dev 未打包时生效）
# CZTOOL_UNLOCK_SKIP=1

# unlock-api Worker 部署时在 Cloudflare 配置（不要写进客户端 .env）:
# TOKEN_SECRET=随机长字符串
# CZTOOL_PRODUCT_ID=EdgeKey 商品 ID（可选，限制只接受该商品卡密）
